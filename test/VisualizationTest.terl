@test
pub svg_visualizations_validate_columns(): Bool ->
    case read_csv("test/fixtures/people.csv") {
        Err(_error) -> false;
        Ok(df) ->
            let valid =
                case plot_line_svg(df, "missing", "age", "Invalid") {
                    Err(_error) -> true;
                    Ok(_svg) -> false
                };
            let _disposed = dispose(df);
            valid
    }.

@test
pub typed_plot_options_cover_line_color_and_bar_facets(): Bool ->
    case read_csv("test/fixtures/people.csv") {
        Err(_error) -> false;
        Ok(df) ->
            let {
                Ok(line_color) <- with_plot_color(plot_options(), "city");
                Ok(line_title) <- with_plot_title(line_color, "Age by city");
                Ok(line_options) <- with_plot_dimensions(line_title, 720, 480);
                Ok(_line) <- plot_line_svg_with_options(df, "age", "age", line_options);
                Ok(bar_options) <- with_plot_column(plot_options(), "city", 2);
                Ok(_bar) <- plot_bar_svg_with_options(df, "city", "age", bar_options)
            } else {
                _ ->
                    let _disposed = dispose(df);
                    false
            };
            (let _disposed = dispose(df); true)
    }.
