module polars.DataFrameSortTest.

import polars.DataFrame.{dispose, filter_eq, head, height, read_csv, sort_by}.
import std.core.Result.{Err, Ok}.

@test
pub sort_by_orders_rows_and_reports_missing_columns(): Bool ->
    case read_csv("test/fixtures/people.csv") {
        Err(_error) -> false;
        Ok(df) ->
            let ordered =
                case sort_by(df, "age", true) {
                    Err(_error) -> false;
                    Ok(sorted) ->
                        let valid =
                            case head(sorted, 1) {
                                Err(_error) -> false;
                                Ok(first) ->
                                    let is_oldest =
                                        case filter_eq(first, "age", 85) {
                                            Err(_error) -> false;
                                            Ok(oldest) ->
                                                let matches = height(oldest) == 1;
                                                let _disposed_at_3131 = dispose(oldest);
                                                matches
                                        };
                                    let _disposed_at_3134 = dispose(first);
                                    is_oldest
                            };
                        let _disposed_at_3137 = dispose(sorted);
                        valid
                };
            let missing_column_fails =
                case sort_by(df, "missing", false) {
                    Err(_error) -> true;
                    Ok(unexpected) ->
                        let _disposed = dispose(unexpected);
                        false
                };
            let _disposed_at_3148 = dispose(df);
            ordered and missing_column_fails
    }.
