module polars.DataFrameGroupCountTest.

import polars.DataFrame.{dispose, group_count, height, read_csv, width}.
import std.core.Result.{Err, Ok}.

@test
pub group_count_materializes_counts(): Bool ->
    case read_csv("test/fixtures/groups.csv") {
        Err(_error) -> false;
        Ok(df) ->
            let valid =
                case group_count(df, ["city"]) {
                    Err(_error) -> false;
                    Ok(grouped) ->
                        let shape_is_valid = height(grouped) == 2 and width(grouped) == 2;
                        let _disposed_at_2508 = dispose(grouped);
                        shape_is_valid
                };
            let _disposed_at_2511 = dispose(df);
            valid
    }.

@test
pub group_count_rejects_empty_keys(): Bool ->
    case read_csv("test/fixtures/groups.csv") {
        Err(_error) -> false;
        Ok(df) ->
            let rejected =
                case group_count(df, []) {
                    Err(_error) -> true;
                    Ok(unexpected) ->
                        let _disposed = dispose(unexpected);
                        false
                };
            let _disposed_at_2531 = dispose(df);
            rejected
    }.

@test
pub group_count_rejects_missing_keys(): Bool ->
    case read_csv("test/fixtures/groups.csv") {
        Err(_error) -> false;
        Ok(df) ->
            let rejected =
                case group_count(df, ["missing"]) {
                    Err(_error) -> true;
                    Ok(unexpected) ->
                        let _disposed = dispose(unexpected);
                        false
                };
            let _disposed_at_2552 = dispose(df);
            rejected
    }.
