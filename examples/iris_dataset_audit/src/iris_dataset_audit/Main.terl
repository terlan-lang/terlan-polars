module iris_dataset_audit.Main.

import polars.DataFrame.{collect, dispose, group_count, height, lazy, project, read_csv, release, rows, schema, select, sort_by, where_eq, width}.
import std.collections.List.
import std.core.Result.{Err, Ok}.
import std.core.Unit.
import std.io.Console.{println}.

import type polars.DataFrame.
import type polars.DataFrame.{ColumnSchema}.

pub schema_is_valid(df: DataFrame): Bool ->
    case schema(df) {
        [sepal_length, sepal_width, petal_length, petal_width, species] ->
            sepal_length.name == "sepal_length_cm"
                and sepal_length.data_type == "Float64"
                and sepal_width.name == "sepal_width_cm"
                and sepal_width.data_type == "Float64"
                and petal_length.name == "petal_length_cm"
                and petal_length.data_type == "Float64"
                and petal_width.name == "petal_width_cm"
                and petal_width.data_type == "Float64"
                and species.name == "species"
                and species.data_type == "String";
        _ -> false
    }.

pub class_balance_is_valid(df: DataFrame): Bool ->
    let keys = List.new();
    keys.push("species");
    case group_count(df, keys) {
        Err(_error) -> false;
        Ok(grouped) ->
            let valid =
                case sort_by(grouped, "species", false) {
                    Err(_error) -> false;
                    Ok(sorted) ->
                        let matches =
                            case rows(sorted, 3) {
                                Ok([["Iris-setosa", "50"], ["Iris-versicolor", "50"], ["Iris-virginica", "50"]]) ->
                                    true;
                                _ -> false
                            };
                        let _disposed_at_1648 = dispose(sorted);
                        matches
                };
            let _disposed_at_1651 = dispose(grouped);
            valid
    }.

pub feature_projection_is_valid(df: DataFrame): Bool ->
    let columns = List.new();
    columns.push("sepal_length_cm");
    columns.push("sepal_width_cm");
    columns.push("petal_length_cm");
    columns.push("petal_width_cm");
    case select(df, columns) {
        Err(_error) -> false;
        Ok(features) ->
            let first_row_is_valid =
                case rows(features, 1) {
                    Ok([["5.1", "3.5", "1.4", "0.2"]]) -> true;
                    _ -> false
                };
            let valid = height(features) == 150 and width(features) == 4 and first_row_is_valid;
            let _disposed_at_1671 = dispose(features);
            valid
    }.

pub lazy_setosa_partition_is_valid(df: DataFrame): Bool ->
    let plan = lazy(df);
    let filtered = where_eq(plan, "species", "Iris-setosa");
    let columns = List.new();
    columns.push("sepal_length_cm");
    columns.push("sepal_width_cm");
    columns.push("petal_length_cm");
    columns.push("petal_width_cm");
    let projected = project(filtered, columns);
    let valid =
        case collect(projected) {
            Err(_error) -> false;
            Ok(setosa_features) ->
                let matches = height(setosa_features) == 50 and width(setosa_features) == 4;
                let _disposed_at_1690 = dispose(setosa_features);
                matches
        };
    (release(projected); release(filtered); release(plan); valid).

pub audit(): Bool ->
    case read_csv("examples/iris_dataset_audit/data/iris.csv") {
        Err(_error) -> false;
        Ok(df) ->
            let shape_is_valid = height(df) == 150 and width(df) == 5;
            let schema_is_valid = schema_is_valid(df);
            let classes_are_balanced = class_balance_is_valid(df);
            let features_are_valid = feature_projection_is_valid(df);
            let lazy_partition_is_valid = lazy_setosa_partition_is_valid(df);
            let _disposed_at_1709 = dispose(df);
            shape_is_valid
                and schema_is_valid
                and classes_are_balanced
                and features_are_valid
                and lazy_partition_is_valid
    }.

pub require_true(value: Bool): Unit ->
    case value {
        true -> Unit
    }.

pub main(): Unit ->
    require_true(audit());
    println("Iris dataset audit passed: 150 rows, 4 numeric features, 3 balanced species classes.").
