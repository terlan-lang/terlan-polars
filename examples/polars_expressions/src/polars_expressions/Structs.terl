module polars_expressions.Structs.

import polars.DataFrame.{add, alias, as_struct, col, dispose, filter, gt, height, len_expr, lit, over, rank_dense_descending, read_csv, select_exprs, string_len_bytes, struct_field, value_counts, width, with_columns}.
import type polars.DataFrame.{DataFrame, Expr}.
import std.collections.List.
import type std.collections.List.
import std.core.Result.{Err, Ok}.

pub expressions(): List[Expr] -> List.new().
pub append(values: List[Expr], value: Expr): List[Expr] -> values.push(value); values.
pub one(value: Expr): List[Expr] -> append(expressions(), value).
pub two(first: Expr, second: Expr): List[Expr] -> append(one(first), second).
pub three(first: Expr, second: Expr, third: Expr): List[Expr] -> append(two(first, second), third).

pub value_count_examples(ratings: DataFrame): Bool ->
    let counts = value_counts(col("Theatre"));
    let structured = case select_exprs(ratings, one(counts)) {
        Err(_error) -> false;
        Ok(result) -> let valid = height(result) == 5 and width(result) == 1; dispose(result); valid
    };
    let fields = two(struct_field(counts, "Theatre"), struct_field(counts, "count"));
    let unnested = case select_exprs(ratings, fields) {
        Err(_error) -> false;
        Ok(result) -> let valid = height(result) == 5 and width(result) == 2; dispose(result); valid
    };
    structured and unnested.

pub series_struct_examples(): Bool ->
    case read_csv("examples/polars_expressions/data/struct_series.csv") {
        Err(_error) -> false;
        Ok(df) ->
            let packed = as_struct(three(col("Movie"), col("Theatre"), col("Avg_Rating")));
            let series_struct = case select_exprs(df, one(alias(packed, "ratings"))) {
                Err(_error) -> false;
                Ok(result) -> let valid = height(result) == 2 and width(result) == 1; dispose(result); valid
            };
            let extracted = case select_exprs(df, one(struct_field(packed, "Movie"))) {
                Err(_error) -> false;
                Ok(result) -> let valid = height(result) == 2 and width(result) == 1; dispose(result); valid
            };
            let _disposed_at_2721 = dispose(df);
            series_struct and extracted
    }.

pub struct_ranking(ratings: DataFrame): Bool ->
    let score = as_struct(two(col("Count"), col("Avg_Rating")));
    let rank = alias(over(rank_dense_descending(score), two(col("Movie"), col("Theatre"))), "Rank");
    case with_columns(ratings, one(rank)) {
        Err(_error) -> false;
        Ok(ranked) ->
            let duplicates = gt(over(len_expr(), two(col("Movie"), col("Theatre"))), lit(1));
            let valid = case filter(ranked, duplicates) {
                Err(_error) -> false;
                Ok(result) -> let matches = height(result) == 5 and width(result) == 5; dispose(result); matches
            };
            let _disposed_at_2736 = dispose(ranked);
            valid
    }.

pub multi_column_apply(): Bool ->
    case read_csv("examples/polars_expressions/data/struct_apply.csv") {
        Err(_error) -> false;
        Ok(df) ->
            let solution = add(string_len_bytes(col("keys")), col("values"));
            let values = two(alias(solution, "solution_map_elements"), alias(solution, "solution_expr"));
            let valid = case select_exprs(df, values) {
                Err(_error) -> false;
                Ok(result) -> let matches = height(result) == 3 and width(result) == 2; dispose(result); matches
            };
            let _disposed_at_2750 = dispose(df);
            valid
    }.

/** Covers all seven executable regions in upstream structs.rs. */
pub run(): Bool ->
    case read_csv("examples/polars_expressions/data/struct_ratings.csv") {
        Err(_error) -> false;
        Ok(ratings) ->
            let valid = height(ratings) == 10 and width(ratings) == 4 and
                value_count_examples(ratings) and series_struct_examples() and
                struct_ranking(ratings) and multi_column_apply();
            let _disposed_at_2762 = dispose(ratings);
            valid
    }.
