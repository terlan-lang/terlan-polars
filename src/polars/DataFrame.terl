/**
 * Public Polars DataFrame package API.
 *
 * `polars.DataFrame` is the first external Terlan package probe. The source
 * API is intentionally small and opaque: Terlan code can typecheck imports and
 * pass DataFrame values through stable functions, while the native Rust adapter
 * owns the real Polars values.
 */
module polars.DataFrame.

import std.collections.List.
import std.core.Result.{Err, Ok}.

import type std.collections.List.
import type std.core.{Error, Option, Result}.

/**
 * DataFrame represents an opaque Polars data frame value.
 *
 * Input: no direct Terlan construction input.
 * Output: an opaque handle type whose representation is owned by the native
 * Rust adapter.
 * Transformation: prevents Terlan source from depending on Polars internals
 * while allowing typed calls across package boundaries.
 */
pub opaque type DataFrame.

/**
 * LazyFrame represents an opaque, unexecuted Polars query plan.
 *
 * Transformations return new plans. Call `collect()` to execute a plan and
 * `release()` on every plan handle when ownership is complete.
 */
pub opaque type LazyFrame.

/**
 * DataFrameSet owns multiple DataFrames produced by partitioned or batched
 * execution.
 */
pub opaque type DataFrameSet.

/**
 * LazyFrameSet owns multiple plans for context and multi-plan execution.
 */
pub opaque type LazyFrameSet.

/**
 * Series represents one independently owned Polars column.
 *
 * A Series is a helper-owned resource. Call `dispose_series` when ownership is
 * complete; copied aliases are invalidated together.
 */
pub opaque type Series.

/**
 * SqlContext owns a set of named lazy tables used by Polars SQL queries.
 *
 * Registering a DataFrame clones its logical input, so the source DataFrame
 * remains independently owned. Call `dispose_sql_context` when the context is
 * no longer needed.
 */
pub opaque type SqlContext.

/**
 * ColumnSchema describes one DataFrame column.
 *
 * Input: a column name and its Polars data type rendered as stable text.
 * Output: a transparent schema entry suitable for inspection and matching.
 * Transformation: keeps the package boundary independent of Polars' internal
 * Rust data-type representation while preserving column order and type names.
 */
pub struct ColumnSchema {
    name: String,
    data_type: String,
}.

/**
 * Scalar values accepted by typed DataFrame predicates.
 */
pub type Scalar = String | Int | Float | Bool.

/**
