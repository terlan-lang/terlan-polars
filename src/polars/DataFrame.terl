/**
 * Constructs a column-free DataFrame with an explicit non-negative height.
 */
@compiler.native {polars.dataframe.empty_with_height}
pub dataframe_empty_with_height(_height: Int): Result[DataFrame, Error] ->
    native.

/**
 * Constructs a typed DataFrame from an ordered list of named Series.
 *
 * The Series remain independently owned by the caller. An empty list produces
 * a column-free, zero-row DataFrame.
 */
pub dataframe_from_series(columns: List[Series]): Result[DataFrame, Error] ->
    case columns {
        [] -> dataframe_empty_with_height(0);
        [first | rest] ->
            case series_to_frame(first) {
                Err(error) -> Err(error);
                Ok(dataframe) -> dataframe_add_series(dataframe, rest)
            }
    }.

dataframe_add_series(dataframe: DataFrame, columns: List[Series]): Result[DataFrame, Error] ->
    case columns {
        [] -> Ok(dataframe);
        [column | rest] ->
            case dataframe_with_column(dataframe, column) {
                Err(error) ->
                    let _disposed = dispose(dataframe);
                    Err(error);
                Ok(next) ->
                    let _disposed = dispose(dataframe);
                    dataframe_add_series(next, rest)
            }
    }.

