/**
 * Builds CSV read options.
 *
 * Negative optional integer values select Polars defaults. Empty option lists
 * select all columns or inferred schemas. `null_mode` is `none`, `single`,
 * `all`, or `named`; named null values pair `null_columns` with `null_values`.
 */
@compiler.native {polars.io.csv_read_options}
pub csv_read_options(
    has_header: Bool = true,
    separator: String = ",",
    quote_char: String = "\"",
    eol_char: String = "\n",
    encoding: String = "utf8",
    null_mode: String = "none",
    null_values: List[String] = [],
    null_columns: List[String] = [],
    missing_is_null: Bool = true,
    truncate_ragged_lines: Bool = false,
    comment_prefix: String = "",
    try_parse_dates: Bool = false,
    decimal_comma: Bool = false,
    rechunk: Bool = false,
    n_threads: Int = -1,
    low_memory: Bool = false,
    n_rows: Int = -1,
    columns: List[String] = [],
    projection: List[Int] = [],
    schema_names: List[String] = [],
    schema_types: List[String] = [],
    schema_overwrite_names: List[String] = [],
    schema_overwrite_types: List[String] = [],
    dtype_overwrite: List[String] = [],
    chunk_size: Int = 262144,
    skip_rows: Int = 0,
    skip_lines: Int = 0,
    skip_rows_after_header: Int = 0,
    infer_schema_length: Int = 100,
    raise_if_empty: Bool = true,
    ignore_errors: Bool = false,
    row_index_name: String = "",
    row_index_offset: Int = 0,
): Result[CsvReadOptions, Error] ->
    native.

