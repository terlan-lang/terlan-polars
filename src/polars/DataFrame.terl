/**
 * Expr is an immutable Polars expression.
 *
 * Its String representation is private to this module, so callers can compose
 * typed expressions but cannot forge adapter instructions.
 */
pub opaque type Expr = String.

/**
 * ExprUdf is an immutable declarative expression template.
 *
 * It contains no host callback or native pointer. Applying it substitutes
 * typed expression arguments before the resulting expression reaches Polars.
 */
pub opaque type ExprUdf = String.

