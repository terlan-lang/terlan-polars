/**
 * Typed public representation of Polars scalar logical data types.
 */
pub type Boolean.

pub type Int8.

pub type Int16.

pub type Int32.

pub type Int64.

pub type Int128.

pub type UInt8.

pub type UInt16.

pub type UInt32.

pub type UInt64.

pub type UInt128.

pub type Float16.

pub type Float32.

pub type Float64.

pub type Utf8.

pub type DateType.

pub type TimeType.

pub type DatetimeMicroseconds.

pub type DatetimeMilliseconds.

pub type DatetimeNanoseconds.

pub type DurationMilliseconds.

pub type DurationMicroseconds.

pub type DurationNanoseconds.

pub type BinaryType.

pub type BinaryOffsetType.

pub type NullType.

pub type DataType =
      Boolean
    | Int8
    | Int16
    | Int32
    | Int64
    | Int128
    | UInt8
    | UInt16
    | UInt32
    | UInt64
    | UInt128
    | Float16
    | Float32
    | Float64
    | Utf8
    | BinaryType
    | BinaryOffsetType
    | DateType
    | TimeType
    | DatetimeMilliseconds
    | DatetimeMicroseconds
    | DatetimeNanoseconds
    | DurationMilliseconds
    | DurationMicroseconds
    | DurationNanoseconds
    | NullType.

/**
 * Time units accepted by timezone-aware Datetime construction.
 */
pub type DatetimeUnit = DatetimeMilliseconds | DatetimeMicroseconds | DatetimeNanoseconds.

/**
 * Cardinality contracts checked while executing equi joins.
 */
pub type ManyToMany.

pub type ManyToOne.

pub type OneToMany.

pub type OneToOne.

pub type JoinValidation = ManyToMany | ManyToOne | OneToMany | OneToOne.

/**
 * Deterministic row-order policies for equi joins.
 */
pub type Unordered.

pub type PreserveLeft.

pub type PreserveRight.

pub type PreserveLeftRight.

pub type PreserveRightLeft.

pub type JoinOrder =
      Unordered
    | PreserveLeft
    | PreserveRight
    | PreserveLeftRight
    | PreserveRightLeft.

/**
 * Duplicate-row retention strategies.
 */
pub type KeepFirst.

pub type KeepLast.

pub type KeepAny.

pub type KeepNone.

pub type UniqueKeep = KeepFirst | KeepLast | KeepAny | KeepNone.

/**
 * Opaque recursively composable parameterized Polars data type.
 */
pub opaque type NestedDataType = String.

/**
 * Opaque named field used while constructing a Struct data type.
 */
pub opaque type DataTypeField = String.

/**
 * Any scalar or parameterized Polars data type.
 */
pub type PolarsDataType = DataType | NestedDataType.

/**
 * Compile-time evidence that a value has one portable Polars data-type representation.
 */
pub trait DataTypeValue[T] {
    data_type_value(value: T): T ->
        value.
}.

/**
 * Admits singleton scalar data types to generic data-type operations.
 */
pub impl DataTypeValue[Boolean] for Boolean {
}.

pub impl DataTypeValue[Int8] for Int8 {
}.

pub impl DataTypeValue[Int16] for Int16 {
}.

pub impl DataTypeValue[Int32] for Int32 {
}.

pub impl DataTypeValue[Int64] for Int64 {
}.

pub impl DataTypeValue[Int128] for Int128 {
}.

pub impl DataTypeValue[UInt8] for UInt8 {
}.

pub impl DataTypeValue[UInt16] for UInt16 {
}.

pub impl DataTypeValue[UInt32] for UInt32 {
}.

pub impl DataTypeValue[UInt64] for UInt64 {
}.

pub impl DataTypeValue[UInt128] for UInt128 {
}.

pub impl DataTypeValue[Float16] for Float16 {
}.

pub impl DataTypeValue[Float32] for Float32 {
}.

pub impl DataTypeValue[Float64] for Float64 {
}.

pub impl DataTypeValue[Utf8] for Utf8 {
}.

pub impl DataTypeValue[BinaryType] for BinaryType {
}.

pub impl DataTypeValue[BinaryOffsetType] for BinaryOffsetType {
}.

pub impl DataTypeValue[DateType] for DateType {
}.

pub impl DataTypeValue[TimeType] for TimeType {
}.

pub impl DataTypeValue[DatetimeMilliseconds] for DatetimeMilliseconds {
}.

pub impl DataTypeValue[DatetimeMicroseconds] for DatetimeMicroseconds {
}.

pub impl DataTypeValue[DatetimeNanoseconds] for DatetimeNanoseconds {
}.

pub impl DataTypeValue[DurationMilliseconds] for DurationMilliseconds {
}.

pub impl DataTypeValue[DurationMicroseconds] for DurationMicroseconds {
}.

pub impl DataTypeValue[DurationNanoseconds] for DurationNanoseconds {
}.

pub impl DataTypeValue[NullType] for NullType {
}.

/**
 * Admits parameterized data types to generic data-type operations.
 */
pub impl DataTypeValue[NestedDataType] for NestedDataType {
}.

/**
 * Immutable options for eager CSV reads.
 */
pub opaque type CsvReadOptions = String.

/**
 * Immutable options for eager CSV writes.
 */
pub opaque type CsvWriteOptions = String.

/**
 * Immutable options for eager JSON and NDJSON reads.
 */
pub opaque type JsonReadOptions = String.

/**
 * Immutable options for eager Parquet reads.
 */
pub opaque type ParquetReadOptions = String.

/**
 * Immutable options for eager Parquet writes.
 */
pub opaque type ParquetWriteOptions = String.

/**
 * Immutable options for eager Arrow IPC reads.
 */
pub opaque type IpcReadOptions = String.

/**
 * Immutable options for eager Arrow IPC writes.
 */
pub opaque type IpcWriteOptions = String.

/**
 * Immutable declarative options for escaped HTML table rendering.
 */
pub opaque type TableStyle = String.

/**
 * Reports terlan-polars and pinned Rust dependency versions.
 */
@compiler.native {polars.show_versions}
pub show_versions(): String ->
    native.

/**
 * Constructs a variable-width List data type.
 */
@compiler.native {polars.dtype.list}
pub list_type[T](_element: T)[DataTypeValue[T]]: NestedDataType ->
    native.

/**
 * Constructs a Map data type with explicit key and value types.
 */
@compiler.native {polars.dtype.map}
pub map_type[K, V](_key: K, _value: V)[DataTypeValue[K], DataTypeValue[V]]: NestedDataType ->
    native.

/**
 * Constructs a fixed-width Array data type.
 */
@compiler.native {polars.dtype.array}
pub array_type[T](_element: T, _width: Int)[DataTypeValue[T]]: NestedDataType ->
    native.

/**
 * Constructs a Decimal data type with precision from 1 through 38.
 */
@compiler.native {polars.dtype.decimal}
pub decimal_type(_precision: Int, _scale: Int): NestedDataType ->
    native.

/**
 * Constructs a global dynamically populated Categorical data type.
 */
@compiler.native {polars.dtype.categorical}
pub categorical_type(): NestedDataType ->
    native.

/**
 * Constructs an ordered Enum data type from one or more unique categories.
 */
@compiler.native {polars.dtype.enum_type}
pub enum_type(_categories: List[String]): NestedDataType ->
    native.

/**
 * Constructs a timezone-aware Datetime data type.
 */
@compiler.native {polars.dtype.datetime_tz}
pub datetime_type(_time_unit: DatetimeUnit, _time_zone: String): NestedDataType ->
    native.

/**
 * Constructs one named Struct field.
 */
@compiler.native {polars.dtype.field}
pub data_type_field[T](_name: String, _data_type: T)[DataTypeValue[T]]: DataTypeField ->
    native.

/**
 * Constructs a Struct data type from one or more named fields.
 */
@compiler.native {polars.dtype.struct_type}
pub struct_type(_fields: List[DataTypeField]): NestedDataType ->
    native.

/**
 * Constructs a portable Polars extension type over an explicit storage type.
 *
 * Extension names and storage remain data; no Rust object or callback crosses
 * the package boundary.
 */
@compiler.native {polars.dtype.extension}
pub extension_type[T](_name: String, _storage: T)[DataTypeValue[T]]: NestedDataType ->
    native.

/**
 * Constructs an extension type carrying serialized extension metadata.
 */
@compiler.native {polars.dtype.extension_metadata}
pub extension_type[T](
    _name: String,
    _metadata: String,
    _storage: T,
)[DataTypeValue[T]]: NestedDataType ->
    native.

/**
 * Formats a data type using Polars' readable nested syntax.
 */
@compiler.native {polars.dtype.pretty_format}
pub pretty_format[T](_data_type: T)[DataTypeValue[T]]: String ->
    native.

/**
 * Returns whether the complete type tree is known.
 */
@compiler.native {polars.dtype.is_known}
pub is_known[T](_data_type: T)[DataTypeValue[T]]: Bool ->
    native.

/**
 * Returns the complete shape of a fixed-size Array type.
 */
@compiler.native {polars.dtype.get_shape}
pub array_shape[T](_data_type: T)[DataTypeValue[T]]: Result[List[Int], Error] ->
    native.

/**
 * Returns the immediate List or Array element type.
 */
@compiler.native {polars.dtype.inner_dtype}
pub inner_data_type[T](_data_type: T)[DataTypeValue[T]]: Result[NestedDataType, Error] ->
    native.

/**
 * Returns the key type of a Map.
 */
@compiler.native {polars.dtype.map_key}
pub map_key_data_type[T](_data_type: T)[DataTypeValue[T]]: Result[NestedDataType, Error] ->
    native.

/**
 * Returns the value type of a Map.
 */
@compiler.native {polars.dtype.map_value}
pub map_value_data_type[T](_data_type: T)[DataTypeValue[T]]: Result[NestedDataType, Error] ->
    native.

/**
 * Returns the absolute List or Array leaf type.
 */
@compiler.native {polars.dtype.leaf_dtype}
pub leaf_data_type[T](_data_type: T)[DataTypeValue[T]]: NestedDataType ->
    native.

/**
 * Returns the absolute leaf type of an Array.
 */
@compiler.native {polars.dtype.array_leaf_dtype}
pub array_leaf_data_type[T](_data_type: T)[DataTypeValue[T]]: Result[NestedDataType, Error] ->
    native.

/**
 * Replaces every List or Array leaf while preserving the nesting.
 */
@compiler.native {polars.dtype.cast_leaf}
pub cast_leaf[T, U](_data_type: T, _target: U)[DataTypeValue[T], DataTypeValue[U]]: NestedDataType ->
    native.

/**
 * Returns whether Polars knows that the requested cast is valid.
 */
@compiler.native {polars.dtype.can_cast_to}
pub can_cast_to[T, U](
    _data_type: T,
    _target: U,
)[DataTypeValue[T], DataTypeValue[U]]: Result[Bool, Error] ->
    native.

/**
 * Wraps this data type in one variable-width List level.
 */
@compiler.native {polars.dtype.implode}
pub implode[T](_data_type: T)[DataTypeValue[T]]: NestedDataType ->
    native.

/**
 * Converts this type recursively to its physical representation.
